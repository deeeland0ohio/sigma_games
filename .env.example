# ---------------------------------------------------------------------------
# AI chat keys — these are SERVER-SIDE secrets.
#
# They are read by the Express server (server/routes/ai.ts) and attached to
# outbound requests from the server. They are never sent to the browser, so
# nothing under src/ needs them and nothing under src/ should ever contain them.
#
# Locally: copy this file to `.env` in the project root and fill in the values.
# On Cloud Run: paste them into Variables & Secrets (see README.md).
# On a VPS: export them in the systemd unit / docker run -e / .env next to the app.
# ---------------------------------------------------------------------------

# Groq (https://console.groq.com/keys) — free tier, rate limited.
# One key is enough. Several keys can be listed here and the server will rotate
# to the next one when one hits its limit. Commas, spaces or new lines all work.
GROQ_API_KEYS=""

# Emis (OpenAI-compatible proxy) — used for the Claude/GPT/Grok model list.
EMIS_API_KEY=""

# Optional: point the proxy at a different upstream.
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
# EMIS_BASE_URL="https://emis.zxs-is-very.cool/v1"

# Port the Express server listens on (Cloud Run sets this itself).
# PORT=3000
