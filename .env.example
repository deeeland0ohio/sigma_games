# ---------------------------------------------------------------------------
# AI chat keys — these are SERVER-SIDE secrets.
#
# They are read by the Express server (server/routes/ai.ts) and attached to
# outbound requests from the server. They are never sent to the browser, so
# nothing under src/ needs them and nothing under src/ should ever contain them.
#
# Locally: copy this file to `.env` in the project root and fill in the values.
# On Cloud Run: paste them into Variables & Secrets (see README.md).
# On a VPS: export them in the systemd unit / docker run -e / .env next to the app.
# ---------------------------------------------------------------------------

# Groq (https://console.groq.com/keys) — free tier, rate limited.
# One key is enough. Several keys can be listed here and the server will rotate
# to the next one when one hits its limit. Commas, spaces or new lines all work.
GROQ_API_KEYS=""

# Emis (OpenAI-compatible proxy) — used for the Claude/GPT/Grok model list.
EMIS_API_KEY=""

# Optional: point the proxy at a different upstream.
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
# EMIS_BASE_URL="https://emis.zxs-is-very.cool/v1"

# Port the Express server listens on (Cloud Run sets this itself).
# PORT=3000

# --- Music -----------------------------------------------------------------
# Wall-clock budget for resolving one track, in milliseconds. The catalogs are
# searched in parallel and whatever cannot be proven within this window falls
# back to the 30-second preview. Raise it if you are on an unblocked host and
# want yt-dlp to have more time.
# MUSIC_RESOLVE_BUDGET_MS=18000

# yt-dlp binary (installed in the Docker image) and a kill switch for it.
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# YT_DLP_DISABLED=1
#
# How many extractions may run at once (default 1). Each process costs real
# memory, and an instance that runs out of it answers 503. Raise this only on a
# host with memory to spare (1Gi+).
# YT_DLP_MAX_CONCURRENT=1

# YouTube refuses anonymous extraction from flagged datacenter IPs (Cloud Run
# included). To check a deployment, open:
#   /api/music/debug?name=SPIN&artist=KROI&duration=305
# It searches every catalog in parallel, picks the best verified YouTube copy and
# tries to extract it, reporting the real reason on failure (`ytDlpProbe.error`)
# and whether a proxy/cookies/extra args are configured (`ytDlp.configured`).
# These are the ways out, in order of how well they work:
#
# 1. Extract through an IP YouTube does not mind — a proxy, or the app on a VPS.
# YT_DLP_PROXY="http://user:pass@host:port"
#
#    Or keep the credential out of the environment entirely: mount the proxy URL
#    as a file (Cloud Run + Secret Manager) and point at it. It is re-read on
#    every extraction, so rotating the secret needs no redeploy.
# YT_DLP_PROXY_FILE="/secrets/yt-dlp-proxy"
#
# 2. Cookies from a signed-in account (Netscape cookies.txt). May still be
#    refused without a PO token, and a flagged account is at risk.
# YT_DLP_COOKIES_FILE="/secrets/cookies.txt"
#
# 3. Anything else, passed straight to the process (e.g. a PO token provider):
# YT_DLP_EXTRA_ARGS="--extractor-args youtube:getpot_bgutil_baseurl=http://127.0.0.1:4416"

# Optional: pin a SoundCloud client id instead of scraping a fresh one.
# SOUNDCLOUD_CLIENT_ID=""
